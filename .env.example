# Copy to .env before starting Compose.
POSTGRES_DB=corporate_procurement_system
POSTGRES_USER=postgres
# Required: choose a database password.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
BACKEND_PORT=8080

# Required: generate with openssl rand -base64 32 and keep stable across restarts.
JWT_SECRET=

# First startup: fill both variables; password must contain 12-72 characters.
# After provisioning, clear both and recreate backend before renaming the admin.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
