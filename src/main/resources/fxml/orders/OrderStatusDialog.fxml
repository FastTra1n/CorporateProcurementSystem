<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.team.corporate.fx.controller.dialog.OrderStatusDialogController"
           styleClass="dialog-stage"
           alignment="CENTER">

    <VBox styleClass="dialog-root, form" maxHeight="-Infinity">

        <!-- Заголовок с крестиком -->
        <HBox styleClass="dialog-header" alignment="CENTER_LEFT">
            <Label fx:id="titleLabel" text="Изменение статуса" styleClass="dialog-title"
                   maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="closeBtn" text="✕" styleClass="dialog-close"/>
        </HBox>

        <!-- Информационный блок (номер заказа и статус) -->
        <VBox styleClass="dialog-status-box">
            <Label fx:id="orderNumberLabel" text="Заказ №1"
                   styleClass="dialog-status-caption"/>
            <HBox styleClass="dialog-status-row">
                <Label text="Текущий статус:" styleClass="dialog-status-label"/>
                <Label fx:id="currentStatusLabel" text="Создан"
                       styleClass="status, status-created"/>
            </HBox>
        </VBox>

        <!-- Новый статус -->
        <VBox styleClass="form-group">
            <Label text="Новый статус *" styleClass="form-label"/>
            <ComboBox fx:id="newStatusCombo" styleClass="form-select"
                      promptText="— Выберите статус —"
                      maxWidth="Infinity"/>
            <Label fx:id="newStatusError"
                   text="Выберите статус из списка"
                   styleClass="form-error"
                   visible="false" managed="false"/>
        </VBox>

        <!-- Кнопки -->
        <HBox styleClass="dialog-actions">
            <Button fx:id="cancelBtn" text="Отмена" styleClass="btn, btn-cancel"/>
            <Button fx:id="changeBtn" text="Изменить статус" styleClass="btn, btn-primary"/>
        </HBox>

    </VBox>
</StackPane>