<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.team.corporate.fx.controller.WarehousesController"
            fitToWidth="true"
            styleClass="page-scroll">

    <fx:define>
        <ToggleGroup fx:id="warehouseGroup"/>
    </fx:define>

    <VBox styleClass="page-content">

        <!-- Кнопка Назад -->
        <HBox styleClass="page-header">
            <Button text="←" styleClass="back-btn"/>
            <Label text="Склады и остатки" styleClass="page-title"/>
        </HBox>

        <!-- Поиск + кнопки действий -->
        <VBox styleClass="content-block">

            <HBox styleClass="search-row">
                <TextField fx:id="searchField" styleClass="search-input"
                           promptText="Поиск склада по названию или адресу..."
                           HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox styleClass="action-row">
                <Button fx:id="createWarehouseBtn" text="Создать склад"
                        styleClass="btn, btn-success"/>
                <Button fx:id="addProductBtn" text="Добавить товар на склад"
                        styleClass="btn, btn-primary"/>
                <Button fx:id="changeQtyBtn" text="Изменить остаток"
                        styleClass="btn, btn-warning"/>
                <Button fx:id="deleteBtn" text="Удалить"
                        styleClass="btn, btn-danger"/>
            </HBox>

        </VBox>

        <!-- Два блока -->
        <GridPane hgap="20">
            <columnConstraints>
                <ColumnConstraints minWidth="280" prefWidth="280" maxWidth="280"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <!-- Склады (левый блок) -->
            <VBox styleClass="warehouses-list" GridPane.columnIndex="0">
                <Label text="Склады" styleClass="warehouses-list-title"/>

                <VBox fx:id="warehousesListItems" styleClass="warehouses-list-items">
                    <!-- Карточка категории тест. Контроллер сгенерирует их из БД -->
<!--                    <ToggleButton text="Главный склад"-->
<!--                                  styleClass="warehouse-item"-->
<!--                                  toggleGroup="$warehouseGroup">-->
<!--                        <graphic>-->
<!--                            <VBox spacing="4">-->
<!--                                <Label text="Главный склад" styleClass="warehouse-item-name"/>-->
<!--                                <Label text="г. Москва, ул. Ленина 1" styleClass="warehouse-item-address"/>-->
<!--                            </VBox>-->
<!--                        </graphic>-->
<!--                    </ToggleButton>-->

<!--                    <ToggleButton text="Резервный склад"-->
<!--                                  styleClass="warehouse-item"-->
<!--                                  toggleGroup="$warehouseGroup">-->
<!--                        <graphic>-->
<!--                            <VBox spacing="4">-->
<!--                                <Label text="Резервный склад" styleClass="warehouse-item-name"/>-->
<!--                                <Label text="г. Москва, ул. Мира 15" styleClass="warehouse-item-address"/>-->
<!--                            </VBox>-->
<!--                        </graphic>-->
<!--                    </ToggleButton>-->

<!--                    <ToggleButton text="Склад филиала"-->
<!--                                  styleClass="warehouse-item"-->
<!--                                  toggleGroup="$warehouseGroup">-->
<!--                        <graphic>-->
<!--                            <VBox spacing="4">-->
<!--                                <Label text="Склад филиала" styleClass="warehouse-item-name"/>-->
<!--                                <Label text="г. СПб, Невский пр. 50" styleClass="warehouse-item-address"/>-->
<!--                            </VBox>-->
<!--                        </graphic>-->
<!--                    </ToggleButton>-->
                </VBox>
            </VBox>

            <!-- Остатки (правый блок) -->
            <VBox styleClass="inventory-block" GridPane.columnIndex="1">
                <Label fx:id="inventoryTitleLabel" text="Остатки"
                       styleClass="inventory-block-title"/>

                <TableView fx:id="inventoryTable" styleClass="data-table">
                    <placeholder>
                        <Label text="Нет данных" styleClass="table-placeholder"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="productCol" text="Товар"       prefWidth="250"/>
                        <TableColumn fx:id="skuCol"     text="Артикул"     prefWidth="200"/>
                        <TableColumn fx:id="qtyCol"     text="Количество"  prefWidth="140"/>
                    </columns>
                </TableView>
            </VBox>
        </GridPane>

    </VBox>
</ScrollPane>