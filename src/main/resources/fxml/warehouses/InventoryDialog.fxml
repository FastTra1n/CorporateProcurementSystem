<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.team.corporate.fx.controller.dialog.InventoryDialogController"
           styleClass="dialog-stage"
           alignment="CENTER">

    <VBox styleClass="dialog-root, form" maxHeight="-Infinity">

        <!-- Заголовок с крестиком -->
        <HBox styleClass="dialog-header" alignment="CENTER_LEFT">
            <Label fx:id="titleLabel" text="Остаток товара" styleClass="dialog-title"
                   maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="closeBtn" text="✕" styleClass="dialog-close"/>
        </HBox>

        <!-- Склад -->
        <VBox styleClass="form-group">
            <Label text="Склад *" styleClass="form-label"/>
            <ComboBox fx:id="warehouseCombo" styleClass="form-select"
                      promptText="— Выберите склад —"
                      maxWidth="Infinity"/>
            <Label fx:id="warehouseError"
                   text="Выберите склад из списка"
                   styleClass="form-error"
                   visible="false" managed="false"/>
        </VBox>

        <!-- Товар -->
        <VBox styleClass="form-group">
            <Label text="Товар *" styleClass="form-label"/>
            <ComboBox fx:id="productCombo" styleClass="form-select"
                      promptText="— Выберите товар —"
                      maxWidth="Infinity"/>
            <Label fx:id="productError"
                   text="Выберите товар из списка"
                   styleClass="form-error"
                   visible="false" managed="false"/>
        </VBox>

        <!-- Количество -->
        <VBox styleClass="form-group">
            <Label text="Количество *" styleClass="form-label"/>
            <TextField fx:id="quantityField" styleClass="form-input"
                       promptText="0"/>
            <Label fx:id="quantityError"
                   text="Введите целое число от 0 до 2 147 483 647"
                   styleClass="form-error"
                   visible="false" managed="false"/>
        </VBox>

        <!-- Кнопки -->
        <HBox styleClass="dialog-actions">
            <Button fx:id="cancelBtn" text="Отмена" styleClass="btn, btn-cancel"/>
            <Button fx:id="saveBtn" text="Сохранить" styleClass="btn, btn-primary"/>
        </HBox>

    </VBox>
</StackPane>