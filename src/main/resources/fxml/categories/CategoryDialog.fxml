<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.team.corporate.fx.controller.dialog.CategoryDialogController"
           styleClass="dialog-stage"
           alignment="CENTER">

    <VBox styleClass="dialog-root, form" maxHeight="-Infinity">

        <!-- Заголовок с крестиком -->
        <HBox styleClass="dialog-header" alignment="CENTER_LEFT">
            <Label fx:id="titleLabel" text="Категория" styleClass="dialog-title"
                   maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="closeBtn" text="✕" styleClass="dialog-close"/>
        </HBox>

        <!-- Название -->
        <VBox styleClass="form-group">
            <Label text="Название категории *" styleClass="form-label"/>
            <TextField fx:id="nameField" styleClass="form-input"
                       promptText="Введите название категории"/>
            <Label fx:id="nameError"
                   text="Название категории не может быть пустым"
                   styleClass="form-error"
                   visible="false" managed="false"/>
        </VBox>

        <!-- Кнопки -->
        <HBox styleClass="dialog-actions">
            <Button fx:id="cancelBtn" text="Отмена" styleClass="btn, btn-cancel"/>
            <Button fx:id="saveBtn" text="Сохранить" styleClass="btn, btn-primary"/>
        </HBox>

    </VBox>
</StackPane>