<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<!-- <?import javafx.scene.layout.StackPane?> -->

<ScrollPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.team.corporate.fx.controller.CategoriesController"
            fitToWidth="true"
            styleClass="page-scroll">

    <VBox styleClass="page-content">

        <!-- Кнопка Назад -->
        <HBox styleClass="page-header">
            <Button text="←" styleClass="back-btn"/>
            <Label text="Категории" styleClass="page-title"/>
        </HBox>

        <!-- Поиск + кнопки -->
        <VBox styleClass="content-block">

            <HBox styleClass="search-row">
                <TextField fx:id="searchField" styleClass="search-input"
                           promptText="Поиск по названию категории..."
                           HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox styleClass="action-row">
                <Button fx:id="addBtn" text="Добавить"
                        styleClass="btn, btn-add"/>
                <Button fx:id="editBtn" text="Редактировать"
                        styleClass="btn, btn-edit"/>
                <Button fx:id="deleteBtn" text="Удалить"
                        styleClass="btn, btn-delete"/>
            </HBox>

        </VBox>

        <!-- Сетка категорий -->
        <VBox styleClass="content-block, categories-block">

            <GridPane fx:id="categoriesGrid" hgap="16" vgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>
                <!-- Карточка категории тест-->
<!--                <StackPane styleClass="category-card, cat-purple"-->
<!--                           GridPane.rowIndex="0" GridPane.columnIndex="0">-->
<!--                    <Label text="Офисная техника" styleClass="category-card-title"/>-->
<!--                </StackPane>-->
<!--                <StackPane styleClass="category-card, cat-orange"-->
<!--                           GridPane.rowIndex="0" GridPane.columnIndex="1">-->
<!--                    <Label text="Канцелярские товары" styleClass="category-card-title"/>-->
<!--                </StackPane>-->
            </GridPane>

            <Label fx:id="emptyPlaceholder" text="Категории не найдены"
                   styleClass="table-placeholder"/>

        </VBox>

    </VBox>
</ScrollPane>