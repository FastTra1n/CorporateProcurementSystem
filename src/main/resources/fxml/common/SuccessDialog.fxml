<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import com.pavlobu.emojitextflow.EmojiTextFlow?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.team.corporate.fx.controller.dialog.SuccessController"
           styleClass="dialog-stage"
           alignment="CENTER">

    <VBox fx:id="dialogRoot"
          styleClass="dialog-root">

        <EmojiTextFlow fx:id="successEmoji" styleClass="dialog-emoji"/>

        <Label text="Успешно"
               styleClass="dialog-title-plain, success"
               maxWidth="Infinity" alignment="CENTER"
               textAlignment="CENTER"/>

        <Label fx:id="successText"
               text="Операция выполнена успешно."
               styleClass="dialog-info-box, success"
               maxWidth="Infinity"
               wrapText="true"/>

        <HBox styleClass="dialog-actions, centered">
            <Button fx:id="okBtn" text="OK"
                    styleClass="btn, btn-primary"/>
        </HBox>

    </VBox>
</StackPane>