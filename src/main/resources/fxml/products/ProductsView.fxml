<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.team.corporate.fx.controller.ProductsController"
            fitToWidth="true"
            styleClass="page-scroll">

    <VBox styleClass="page-content">

        <!-- Кнопка Назад -->
        <HBox styleClass="page-header">
            <Button text="←" styleClass="back-btn"/>
            <Label text="Каталог товаров" styleClass="page-title"/>
        </HBox>

        <!-- Фильтры + кнопки действий -->
        <VBox styleClass="content-block">

            <HBox styleClass="search-row">
                <TextField fx:id="searchField" styleClass="search-input"
                           promptText="Поиск по названию или артикулу..."
                           HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="categoryFilter" styleClass="filter-select"
                          promptText="Все категории"/>
                <TextField fx:id="priceFromField" styleClass="filter-input"
                           promptText="Цена от"/>
                <TextField fx:id="priceToField" styleClass="filter-input"
                           promptText="Цена до"/>
                <ComboBox fx:id="sortCombo" styleClass="filter-select"
                          promptText="Сортировка"/>
            </HBox>

            <HBox styleClass="action-row">
                <Button fx:id="addBtn" text="Добавить"
                        styleClass="btn, btn-add"/>
                <Button fx:id="editBtn" text="Редактировать"
                        styleClass="btn, btn-edit"/>
                <Button fx:id="deleteBtn" text="Удалить"
                        styleClass="btn, btn-delete"/>
            </HBox>

        </VBox>

        <!-- Таблица товаров -->
        <VBox styleClass="content-block">
            <TableView fx:id="productsTable" styleClass="data-table">
                <placeholder>
                    <Label text="Товары не найдены" styleClass="table-placeholder"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="numCol"      text="№"          prefWidth="60"/>
                    <TableColumn fx:id="nameCol"     text="Название"   prefWidth="300"/>
                    <TableColumn fx:id="skuCol"      text="Артикул"    prefWidth="160"/>
                    <TableColumn fx:id="priceCol"    text="Цена"       prefWidth="140"/>
                    <TableColumn fx:id="categoryCol" text="Категория"  prefWidth="200"/>
                </columns>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>