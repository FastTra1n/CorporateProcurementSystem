<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import com.team.corporate.entities.UserRole?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.team.corporate.fx.controller.dialog.UserDialogController"
           styleClass="dialog-stage"
           alignment="CENTER">

    <VBox styleClass="dialog-root, form" maxHeight="-Infinity">

        <!-- Заголовок с крестиком -->
        <HBox styleClass="dialog-header" alignment="CENTER_LEFT">
            <Label fx:id="titleLabel" text="Пользователь" styleClass="dialog-title"
                   maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="closeBtn" text="✕" styleClass="dialog-close"/>
        </HBox>

        <!-- Имя пользователя -->
        <VBox styleClass="form-group">
            <Label text="Имя пользователя *" styleClass="form-label"/>
            <TextField fx:id="usernameField" styleClass="form-input"
                       promptText="Введите имя пользователя"/>
            <Label fx:id="usernameError"
                   text="Имя пользователя не может быть пустым"
                   styleClass="form-error"
                   visible="false" managed="false"/>
        </VBox>

        <!-- Роль -->
        <VBox styleClass="form-group">
            <Label text="Роль *" styleClass="form-label"/>
            <ComboBox fx:id="roleCombo" styleClass="form-select"
                      promptText="— Выберите роль —"
                      maxWidth="Infinity">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <UserRole fx:value="USER"/>
                        <UserRole fx:value="MANAGER"/>
                    </FXCollections>
                </items>
            </ComboBox>
            <Label fx:id="roleError"
                   text="Выберите роль из списка"
                   styleClass="form-error"
                   visible="false" managed="false"/>
        </VBox>

        <!-- Кнопки -->
        <HBox styleClass="dialog-actions">
            <Button fx:id="cancelBtn" text="Отмена" styleClass="btn, btn-cancel"/>
            <Button fx:id="saveBtn" text="Сохранить" styleClass="btn, btn-primary"/>
        </HBox>

    </VBox>
</StackPane>